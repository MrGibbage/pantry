{
  "name": "Pantry",
  "short_name": "Pantry",
  "description": "Pick the week's dinners and review the grocery list.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#2f6b4f",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/static/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Dinners",
      "url": "/dinners"
    },
    {
      "name": "List",
      "url": "/list"
    },
    {
      "name": "Receipt",
      "url": "/receipts"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/jpeg",
            "image/png",
            ".jpg",
            ".jpeg",
            ".png"
          ]
        }
      ]
    }
  }
}
